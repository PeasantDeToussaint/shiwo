/* Skyline: scroll-view must have explicit height */
.home-scroll {
  height: 100vh;
  background: var(--bg);
}

.home-root {
  min-height: 100vh;
  padding: 0 var(--space-12);
  box-sizing: border-box;
}

/* spacer so last card isn't hidden behind the footer */
.home-scroll-pad {
  height: 120rpx;
}

/* ── Hero ─────────────────────────────────────────────────── */
.home-hero {
  padding: 16vh 0 var(--space-18);
  text-align: center;
}

.home-wordmark-row {
  display: inline-flex;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
}

.home-wordmark-badge {
  margin-top: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  background: var(--accent-warm);
  padding: 0 8rpx;
  text-align: center;
}

.home-wordmark-badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #09090a;
  font-family: var(--font-family-display);
  letter-spacing: 0;
}

.home-wordmark {
  display: block;
  font-size: 96rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--text);
  line-height: 1;
  margin-bottom: var(--space-5);
  font-family: var(--font-family-display);
}

.home-tagline {
  display: block;
  font-size: 26rpx;
  color: var(--text-muted);
  letter-spacing: 0.14em;
}

/* ── Feature list ─────────────────────────────────────────── */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-10);
  padding-bottom: var(--space-6);
}

/* ── Feature card ─────────────────────────────────────────── */
.feature-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--border);
  padding: var(--space-14) var(--space-10);
  text-align: center;
  background: transparent;
}

.feature-card-dim {
  opacity: 0.5;
}

/* Painting backdrop */
.feature-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Dark scrim so text stays readable — tweak opacity to taste */
.feature-card-bg-dim {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.62);
}

/* ── Badge ────────────────────────────────────────────────── */
.feature-badge {
  position: absolute;
  top: var(--space-5);
  right: var(--space-5);
  font-size: var(--font-caption);
  color: var(--text-muted);
  letter-spacing: 0.1em;
  border: 1rpx solid var(--border);
  padding: 4rpx 14rpx;
  z-index: 2;
}

/* ── Card text ────────────────────────────────────────────── */
.feature-title {
  display: block;
  position: relative;
  z-index: 2;
  font-size: 48rpx;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: var(--text);
  line-height: 1.2;
  margin-bottom: var(--space-3);
}

.feature-title-dim {
  color: var(--text-secondary);
}

.feature-subtitle {
  display: block;
  position: relative;
  z-index: 2;
  font-size: 26rpx;
  color: var(--text-muted);
  letter-spacing: 0.1em;
}

/* ── Skeleton shimmer ─────────────────────────────────────── */
.feature-card-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--surface);
  overflow: hidden;
}

.feature-card-skeleton-shine {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.04) 50%,
    transparent 100%
  );
  animation: skeleton-sweep 1.8s ease-in-out infinite;
}

@keyframes skeleton-sweep {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ── Footer ───────────────────────────────────────────────── */
.home-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-5) var(--space-12);
  padding-bottom: calc(var(--space-5) + env(safe-area-inset-bottom));
  text-align: center;
  background: var(--bg);
}

.home-footer-text {
  font-size: 22rpx;
  letter-spacing: 0.2em;
  color: var(--text-tertiary);
}
