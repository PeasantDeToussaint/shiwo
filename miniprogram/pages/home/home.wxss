@import "../../styles/editorial-card.wxss";

.home-scroll {
  height: 100vh;
  background: var(--bg);
}

.home-root {
  min-height: 100vh;
  padding: 0 var(--space-12);
  box-sizing: border-box;
}

.home-scroll-pad {
  height: 160rpx;
}

.home-header {
  padding-bottom: var(--space-14);
}

.home-kicker {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.24em;
  margin-bottom: var(--space-4);
  opacity: 0.8;
}

.home-heading-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-6);
  margin-bottom: var(--space-3);
}

.home-title {
  flex: 1;
  font-size: 64rpx;
  line-height: 1.06;
  letter-spacing: 0.02em;
  color: var(--text);
}

.home-count {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.home-sub {
  display: block;
  max-width: 84%;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.home-feature-block,
.home-spotlight,
.home-module {
  margin-bottom: var(--space-14);
}

.home-block-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
  margin-bottom: var(--space-6);
}

.home-block-kicker {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.16em;
}

.home-block-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.04em;
}

.home-block-more {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.home-spotlight-grid,
.home-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-6);
}

.home-rail {
  width: 100%;
  white-space: nowrap;
}

.home-rail-inner {
  display: flex;
  gap: var(--space-6);
  padding-right: var(--space-10);
}

.home-footer-note {
  padding-top: var(--space-4);
}

.home-footer-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
}
