<view class="pf-root page-atmosphere">
  <view class="pf-navbar" style="padding-top: {{statusBarHeight}}px;" />

  <view class="pf-header motion-enter">
    <text class="pf-kicker display-title">ARCHIVE</text>
    <view class="pf-heading-row">
      <text class="pf-title">你的测验档案</text>
      <text class="pf-count">{{quizCount}} 次探索</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="pf-loading">
    <view class="pf-loading-bar" />
  </view>

  <view wx:elif="{{hasCards}}" class="pf-section motion-enter motion-stagger" style="--stagger: 80ms;">
    <view class="pf-section-head">
      <view>
        <text class="pf-section-kicker">最近结果</text>
        <text class="pf-section-title">翻一翻你测过的题</text>
      </view>
      <text wx:if="{{archiveOpened}}" class="pf-counter">{{visibleCards.length}} / {{cards.length}}</text>
    </view>

    <view wx:if="{{!archiveOpened}}" class="pf-archive-gate">
      <text class="pf-archive-copy">先展开你的结果存档，再慢慢回看。</text>
      <view class="pf-archive-action" bindtap="onOpenArchive">打开档案</view>
    </view>

    <scroll-view wx:else scroll-y class="pf-scroll" show-scrollbar="{{false}}">
      <view class="pf-list">
        <view
          wx:for="{{visibleCards}}"
          wx:key="quizId"
          class="pf-item"
          style="{{item.themeStyle}} background: linear-gradient(160deg, {{item.gradStart}} 0%, {{item.gradEnd}} 100%); border-color: {{item.accent}}22;"
        >
          <view class="pf-item-top">
            <text class="pf-item-chip">结果存档</text>
            <text class="pf-item-date">{{item.date}}</text>
          </view>
          <text class="pf-item-result" style="color: {{item.accent}};">{{item.resultTitle}}</text>
          <text class="pf-item-quiz">{{item.quizTitle}}</text>
          <view class="pf-item-actions">
            <view class="pf-item-btn" bindtap="onViewResult" data-idx="{{index}}">查看完整报告</view>
            <view class="pf-item-btn pf-item-btn-dim" bindtap="onRetake" data-idx="{{index}}">再测一次</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{archiveOpened && cards.length > visibleCards.length}}" class="pf-more" bindtap="onToggleAllRecords">
      {{showAllRecords ? '收起部分结果' : '查看全部结果'}}
    </view>
  </view>

  <view wx:elif="{{emptyState}}" class="pf-empty motion-enter motion-stagger card" style="--stagger: 80ms;">
    <text class="pf-empty-kicker">还没有结果</text>
    <text class="pf-empty-title">先去完成一次测验，再回来建立你的档案。</text>
    <text class="pf-empty-link" bindtap="onGoExplore">去探索</text>
  </view>

  <view class="pf-footer motion-enter motion-stagger" style="--stagger: 200ms;">
    <text class="pf-footer-motto">在文学、历史与艺术里，遇见你自己。</text>
  </view>

  <view class="pf-scroll-pad" />
</view>
