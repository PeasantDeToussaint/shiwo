<view class="pf-root page-atmosphere">
  <view class="pf-navbar" style="padding-top: {{statusBarHeight}}px;" />

  <view class="pf-header motion-enter">
    <text class="pf-kicker display-title">ARCHIVE</text>
    <view class="pf-heading-row">
      <text class="pf-title">你的测验档案</text>
      <text class="pf-count">{{quizCount}} 次探索</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="pf-loading">
    <view class="pf-loading-bar" />
  </view>

  <view wx:elif="{{hasCards}}" class="pf-section motion-enter motion-stagger" style="--stagger: 80ms;">
    <view class="pf-section-head">
      <view>
        <text class="pf-section-kicker">最近结果</text>
        <text class="pf-section-title">翻一翻你测过的题</text>
      </view>
      <text class="pf-counter">{{cardIndex + 1}} / {{cardTotal}}</text>
    </view>

    <swiper
      class="pf-swiper"
      previous-margin="56rpx"
      next-margin="56rpx"
      current="{{cardIndex}}"
      bindchange="onSwiperChange"
    >
      <swiper-item
        wx:for="{{cards}}"
        wx:key="quizId"
        class="pf-swiper-item"
      >
        <view
          class="pf-card-outer {{cardIndex === index ? '' : 'pf-card-inactive'}}"
          bindtap="onTapCard"
          data-idx="{{index}}"
        >
          <view class="pf-card-inner {{item.flipped ? 'pf-card-flipped' : ''}}">

            <view
              class="pf-card-face pf-card-front"
              style="background: linear-gradient(160deg, {{item.gradStart}} 0%, {{item.gradEnd}} 100%); border-color: {{item.accent}}22;"
            >
              <view class="pf-card-topline">
                <text class="pf-card-chip">结果存档</text>
                <text class="pf-card-date">{{item.date}}</text>
              </view>

              <view class="pf-card-center">
                <text class="pf-card-result" style="color: {{item.accent}};">{{item.resultTitle}}</text>
              </view>

              <view class="pf-card-foot">
                <text class="pf-card-quiz">{{item.quizTitle}}</text>
                <text class="pf-card-hint">点按翻面</text>
              </view>
            </view>

            <view
              class="pf-card-face pf-card-back"
              style="background: linear-gradient(160deg, {{item.gradStart}} 0%, {{item.gradEnd}} 100%); border-color: {{item.accent}}22;"
            >
              <view class="pf-card-back-top">
                <text class="pf-card-chip">结果卡片</text>
                <text class="pf-card-back-result" style="color: {{item.accent}};">{{item.resultTitle}}</text>
                <text class="pf-card-back-quiz">{{item.quizTitle}}</text>
              </view>

              <view class="pf-card-back-actions" catchtap="">
                <view class="pf-card-back-btn" catchtap="onViewResult" data-idx="{{index}}">
                  查看完整报告
                </view>
                <view class="pf-card-back-btn pf-card-back-btn-dim" catchtap="onRetake" data-idx="{{index}}">
                  再测一次
                </view>
              </view>
            </view>

          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view wx:elif="{{emptyState}}" class="pf-empty motion-enter motion-stagger card" style="--stagger: 80ms;">
    <text class="pf-empty-kicker">还没有结果</text>
    <text class="pf-empty-title">先去完成一次测验，再回来建立你的档案。</text>
    <text class="pf-empty-link" bindtap="onGoExplore">去探索</text>
  </view>

  <view class="pf-footer motion-enter motion-stagger" style="--stagger: 200ms;">
    <text class="pf-footer-motto">在文学、历史与艺术里，遇见你自己。</text>
  </view>

  <view class="pf-scroll-pad" />
</view>
