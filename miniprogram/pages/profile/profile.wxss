.pf-root {
  min-height: 100vh;
  padding: 0 var(--space-12);
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text);
}

.pf-navbar {
  padding-bottom: var(--space-6);
}

.pf-header {
  padding-bottom: var(--space-12);
}

.pf-kicker {
  display: block;
  margin-bottom: var(--space-4);
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.24em;
  opacity: 0.8;
}

.pf-heading-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-6);
  margin-bottom: var(--space-3);
}

.pf-title {
  flex: 1;
  font-size: 58rpx;
  line-height: 1.08;
  letter-spacing: 0.02em;
  color: var(--text);
}

.pf-count {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.pf-sub {
  display: block;
  max-width: 84%;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.pf-loading {
  display: flex;
  justify-content: center;
  padding: var(--space-16) 0;
}

.pf-loading-bar {
  width: 40rpx;
  height: 2rpx;
  background: var(--text-secondary);
  opacity: 0.4;
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.2; }
  50%       { opacity: 0.7; }
}

.pf-section {
  margin-bottom: var(--space-14);
}

.pf-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
  margin-bottom: var(--space-6);
}

.pf-section-kicker {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.16em;
}

.pf-section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.04em;
}

.pf-counter {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.pf-archive-gate {
  padding: var(--space-10);
  border: 1rpx solid var(--border);
  background: rgba(255, 255, 255, 0.02);
}

.pf-archive-copy {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-muted);
  letter-spacing: 0.04em;
}

.pf-archive-action {
  margin-top: var(--space-7);
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.12em;
}

.pf-scroll {
  max-height: 980rpx;
}

.pf-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.pf-item {
  border-radius: var(--radius-lg);
  border: 1rpx solid transparent;
  padding: var(--space-8);
  box-shadow:
    var(--shadow-inset-hairline),
    0 18rpx 40rpx rgba(0, 0, 0, 0.2);
}

.pf-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pf-item-chip {
  font-size: 18rpx;
  color: rgba(255,255,255,0.68);
  letter-spacing: 0.12em;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(255,255,255,0.14);
  padding: 6rpx 14rpx;
  background: rgba(9,9,10,0.18);
}

.pf-item-date {
  font-size: 22rpx;
  color: rgba(255,255,255,0.34);
  letter-spacing: 0.06em;
}

.pf-item-result {
  display: block;
  margin-top: var(--space-8);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.pf-item-quiz {
  display: block;
  margin-top: var(--space-4);
  font-size: 24rpx;
  color: rgba(255,255,255,0.46);
  letter-spacing: 0.06em;
}

.pf-item-actions {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-8);
}

.pf-item-btn {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 0.08em;
  padding: 18rpx 0;
  text-align: center;
  border-top: 1px solid rgba(255,255,255,0.1);
}

.pf-item-btn-dim {
  color: rgba(255,255,255,0.4);
}

.pf-more {
  margin-top: var(--space-6);
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.12em;
}

.pf-empty {
  margin-bottom: var(--space-14);
}

.pf-empty-kicker {
  display: block;
  margin-bottom: var(--space-3);
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.14em;
}

.pf-empty-title {
  display: block;
  margin-bottom: var(--space-6);
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--text);
  letter-spacing: 0.04em;
}

.pf-empty-link {
  display: inline-block;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.12em;
}

.pf-footer {
  padding-top: var(--space-6);
}

.pf-footer-motto {
  font-size: 24rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
  line-height: 1.8;
}

.pf-scroll-pad {
  height: 140rpx;
}

.motion-enter {
  animation: fadeUp 0.5s ease both;
}

.motion-stagger {
  animation-delay: var(--stagger, 0ms);
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
