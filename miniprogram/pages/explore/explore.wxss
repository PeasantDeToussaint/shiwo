@import "../../styles/editorial-card.wxss";

.exp-scroll {
  height: 100vh;
  background: var(--bg);
}

.exp-root {
  min-height: 100vh;
  padding: 0 var(--space-12);
  box-sizing: border-box;
}

.exp-pad {
  height: 160rpx;
}

.exp-header {
  padding-bottom: var(--space-10);
}

.exp-search-shell {
  display: flex;
  align-items: flex-end;
  gap: var(--space-5);
  margin-bottom: var(--space-12);
}

.exp-search {
  position: relative;
  flex: 1;
  padding: 0 0 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.exp-search-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 0.14em;
}

.exp-search-input {
  flex: 1;
  width: auto;
  height: auto;
  padding: 0 56rpx 0 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.exp-search-placeholder {
  color: var(--text-tertiary);
  line-height: 1.5;
  letter-spacing: 0.06em;
}

.exp-search-clear {
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  font-size: 28rpx;
  line-height: 1;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.9;
}

.exp-search-cancel {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.exp-search-empty {
  padding: var(--space-12) 0 var(--space-14);
}

.exp-search-empty-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-muted);
  letter-spacing: 0.04em;
}

.exp-search-grid {
  margin-bottom: var(--space-14);
}

.exp-title {
  display: block;
  font-size: 58rpx;
  line-height: 1.08;
  letter-spacing: 0.02em;
  color: var(--text);
  margin-bottom: var(--space-3);
}

.exp-chip-scroll {
  margin-bottom: var(--space-12);
  white-space: nowrap;
}

.exp-chip-row {
  display: flex;
  gap: var(--space-4);
  padding-right: var(--space-10);
}

.exp-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border);
  background: rgba(255, 255, 255, 0.02);
}

.exp-chip-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.exp-chip-count {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.exp-section,
.exp-coming {
  margin-bottom: var(--space-14);
}

.exp-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
  margin-bottom: var(--space-6);
}

.exp-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.04em;
}

.exp-section-count {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.1em;
}

.exp-section-more {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.exp-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-6);
}

.exp-coming-head {
  margin-bottom: var(--space-5);
}

.exp-coming-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.exp-coming-pill {
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border);
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}
