@import "../../styles/editorial-card.wxss";

.exp-scroll {
  height: 100vh;
  background: var(--bg);
}

.exp-root {
  min-height: 100vh;
  padding: 0 var(--space-12);
  box-sizing: border-box;
}

.exp-pad {
  height: 160rpx;
}

.exp-header {
  padding-bottom: var(--space-10);
}

.exp-kicker {
  display: block;
  margin-bottom: var(--space-4);
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.24em;
  opacity: 0.8;
}

.exp-title {
  display: block;
  font-size: 58rpx;
  line-height: 1.08;
  letter-spacing: 0.02em;
  color: var(--text);
  margin-bottom: var(--space-3);
}

.exp-sub {
  display: block;
  max-width: 82%;
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  line-height: 1.6;
}

.exp-chip-scroll {
  margin-bottom: var(--space-12);
  white-space: nowrap;
}

.exp-chip-row {
  display: flex;
  gap: var(--space-4);
  padding-right: var(--space-10);
}

.exp-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border);
  background: rgba(255, 255, 255, 0.02);
}

.exp-chip-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.exp-chip-count {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.exp-section,
.exp-coming {
  margin-bottom: var(--space-14);
}

.exp-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
  margin-bottom: var(--space-6);
}

.exp-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.04em;
}

.exp-section-count {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.1em;
}

.exp-section-more {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.exp-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-6);
}

.exp-coming-head {
  margin-bottom: var(--space-5);
}

.exp-coming-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.exp-coming-pill {
  padding: var(--space-3) var(--space-5);
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border);
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}
