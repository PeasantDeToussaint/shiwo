@import "../../styles/editorial-card.wxss";

.fq-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 var(--space-12) var(--space-4);
  background: linear-gradient(180deg, rgba(9, 9, 10, 0.88) 0%, rgba(9, 9, 10, 0) 100%);
}

.fq-back {
  font-size: 44rpx;
  color: var(--text-secondary);
  line-height: 1;
  min-width: 60rpx;
}

.fq-nav-label {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 0.14em;
}

.fq-scroll {
  position: fixed;
  inset: 0;
  background: var(--bg);
}

.fq-root {
  padding: 0 var(--space-12);
  box-sizing: border-box;
}

.fq-header {
  margin-bottom: var(--space-10);
}

.fq-kicker {
  display: block;
  margin-bottom: var(--space-4);
  font-size: 20rpx;
  color: var(--text-secondary);
  letter-spacing: 0.18em;
}

.fq-title {
  display: block;
  font-size: 54rpx;
  line-height: 1.08;
  color: var(--text);
  letter-spacing: 0.02em;
  margin-bottom: var(--space-3);
}

.fq-sub {
  display: block;
  max-width: 84%;
  font-size: 24rpx;
  line-height: 1.58;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.fq-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-6);
}

.fq-bottom-spacer {
  height: 120rpx;
}

@keyframes snack-in {
  from { transform: translateY(100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

@keyframes snack-out {
  from { transform: translateY(0);    opacity: 1; }
  to   { transform: translateY(100%); opacity: 0; }
}

.snackbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-6) var(--space-12);
  padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.snackbar-in  { animation: snack-in  0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.snackbar-out { animation: snack-out 0.28s cubic-bezier(0.4, 0, 1, 1)    forwards; }

.snackbar-label {
  font-size: 26rpx;
  letter-spacing: 0.2em;
  color: var(--text-muted);
}
