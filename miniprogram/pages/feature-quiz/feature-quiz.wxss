/* ── Custom nav bar ───────────────────────────────────────── */
.fq-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 var(--space-12) var(--space-4);
  height: calc(140rpx + env(safe-area-inset-top));
  box-sizing: border-box;
}

.fq-back {
  font-size: 36rpx;
  color: var(--text-secondary);
  line-height: 1;
  font-family: var(--font-family-display);
  min-width: 60rpx;
}

.fq-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.fq-brand-name {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.28em;
  color: var(--fg);
  opacity: 0.9;
}

.fq-brand-tagline {
  font-size: 18rpx;
  color: var(--text-muted);
  opacity: 0.5;
  letter-spacing: 0.06em;
}


/* ── Scroll container ─────────────────────────────────────── */
.fq-scroll {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg);
}

.fq-root {
  padding: 0 var(--space-12) 0;
  box-sizing: border-box;
}

/* ── Card List ────────────────────────────────────────────── */
.fq-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-10);
}

/* ── Card ─────────────────────────────────────────────────── */
.fq-card {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
  border-top: 3rpx solid var(--chapter-accent);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: #111112;
  transition: opacity 0.2s ease;
}

.fq-card-unavailable {
  opacity: 0.55;
}

/* ── Skeleton shimmer ─────────────────────────────────────── */
.fq-skeleton {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.fq-skeleton-shine {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.04) 50%,
    transparent 100%
  );
  animation: skeleton-sweep 1.8s ease-in-out infinite;
}

@keyframes skeleton-sweep {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ── Full-bleed painting */
.fq-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Gradient scrim — transparent at top, dark at bottom */
.fq-card-scrim {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(9, 9, 10, 0.18) 0%,
    rgba(9, 9, 10, 0.55) 50%,
    rgba(9, 9, 10, 0.88) 100%
  );
}


/* ── Card Top ─────────────────────────────────────────────── */
.fq-card-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--space-6) var(--space-8) 0;
}

.fq-tag-row {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.fq-tag {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--text-secondary);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  padding: 4rpx 14rpx;
  background: rgba(9, 9, 10, 0.45);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.fq-badge {
  font-size: 20rpx;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  border: 1rpx solid var(--border);
  padding: 4rpx 14rpx;
  background: rgba(9, 9, 10, 0.55);
}

/* ── Card Body (bottom) ───────────────────────────────────── */
.fq-card-body {
  position: relative;
  z-index: 2;
  padding: 0 var(--space-8) var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.fq-card-title {
  display: block;
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--text);
  line-height: 1.2;
}

.fq-card-sub {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
}

/* ── Card Footer ─────────────────────────────────────────── */
.fq-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-3);
}

/* share-element wrapper for the accent bar */
.fq-card-accent-wrap {
  display: block;
  width: 40rpx;
  height: 1rpx;
}

.fq-card-accent-bar {
  width: 40rpx;
  height: 1rpx;
}

.fq-card-arrow {
  font-size: 28rpx;
  color: var(--text-muted);
  font-family: var(--font-family-display);
}

/* ── Bottom spacer ────────────────────────────────────────── */
.fq-bottom-spacer {
  height: 80rpx;
}

/* ── Snackbar ─────────────────────────────────────────────── */
@keyframes snack-in {
  from { transform: translateY(100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

@keyframes snack-out {
  from { transform: translateY(0);    opacity: 1; }
  to   { transform: translateY(100%); opacity: 0; }
}

.snackbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-6) var(--space-12);
  padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.snackbar-in  { animation: snack-in  0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.snackbar-out { animation: snack-out 0.28s cubic-bezier(0.4, 0, 1, 1)    forwards; }

.snackbar-label {
  font-size: 26rpx;
  letter-spacing: 0.2em;
  color: var(--text-muted);
}
