<import src="../../templates/editorial-card.wxml" />

<view class="fq-navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="fq-back" bindtap="onBack">‹</view>
  <text class="fq-nav-label">{{featureLabel}}</text>
</view>

<scroll-view scroll-y class="fq-scroll page-atmosphere">
  <view class="fq-root" style="padding-top: calc({{statusBarHeight}}px + 124rpx);">
    <view class="fq-header motion-enter">
      <text class="fq-kicker">分类页</text>
      <text class="fq-title">{{featureLabel}}</text>
      <text class="fq-sub">{{featureSubhead}}</text>
    </view>

    <view class="fq-grid">
      <block wx:for="{{catalog}}" wx:key="id" wx:for-item="item">
        <template
          is="editorialCard"
          data="{{ item: item, variant: 'grid', showTags: true, meta: item.primaryTag, stagger: 80 + index * 40 }}"
        />
      </block>
    </view>

    <view class="fq-bottom-spacer"></view>
  </view>
</scroll-view>

<!-- Snackbar -->
<view
  wx:if="{{snackbar.visible}}"
  class="snackbar {{snackbar.leaving ? 'snackbar-out' : 'snackbar-in'}}"
>
  <text class="snackbar-label">{{snackbar.label}}</text>
</view>
