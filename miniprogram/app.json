{
  "pages": [
    "pages/home/home",
    "pages/explore/explore",
    "pages/profile/profile",
    "pages/feature-quiz/feature-quiz"
  ],
  "tabBar": {
    "backgroundColor": "#09090a",
    "borderStyle": "black",
    "color": "#555558",
    "selectedColor": "#f5f5f4",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "images/icons/home.png",
        "selectedIconPath": "images/icons/home-active.png"
      },
      {
        "pagePath": "pages/explore/explore",
        "text": "探索",
        "iconPath": "images/icons/explore.png",
        "selectedIconPath": "images/icons/explore-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "images/icons/usercenter.png",
        "selectedIconPath": "images/icons/usercenter-active.png"
      }
    ]
  },
  "subpackages": [
    {
      "root": "subpackages/quiz",
      "name": "quiz",
      "pages": [
        "pages/quiz-intro/quiz-intro",
        "pages/quiz-result/quiz-result",
        "pages/rc-question/rc-question",
        "pages/rc-result/rc-result",
        "pages/city-question/city-question",
        "pages/city-result/city-result",
        "pages/dialect-question/dialect-question",
        "pages/dialect-result/dialect-result",
        "pages/temple-question/temple-question",
        "pages/temple-result/temple-result",
        "pages/generic-question/generic-question",
        "pages/generic-result/generic-result",
        "pages/perfume-result/perfume-result",
        "pages/mbti-result/mbti-result"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home":    { "network": "all", "packages": ["quiz"] },
    "pages/explore/explore": { "network": "all", "packages": ["quiz"] }
  },
  "window": {
    "backgroundColor": "#09090a",
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#09090a",
    "navigationBarTitleText": "",
    "navigationBarTextStyle": "white"
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json",
  "permission": {
    "scope.writePhotosAlbum": {
      "desc": "保存你的红楼梦气质身份卡"
    }
  }
}
