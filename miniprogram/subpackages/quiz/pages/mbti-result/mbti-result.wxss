.mr-scroll {
  height: 100vh;
  background: var(--bg);
}

/* ── Loading ─────────────────────────────────────────── */
.mr-loading {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mr-loading-bar {
  width: 48rpx;
  height: 2rpx;
  background: var(--chapter-accent);
  animation: loadPulse 1.2s ease-in-out infinite;
}

@keyframes loadPulse {
  0%, 100% { opacity: 0.3; transform: scaleX(1); }
  50%       { opacity: 1;   transform: scaleX(2.4); }
}

/* ── Shell ───────────────────────────────────────────── */
.mr-shell { min-height: 100vh; }

/* ── Header ──────────────────────────────────────────── */
.mr-header {
  padding: 120rpx var(--space-14) var(--space-16);
  background: linear-gradient(160deg, var(--chapter-gradient-start) 0%, var(--bg) 100%);
  border-bottom: 1rpx solid var(--divider);
}

/* Brand stamp */
.mr-brand-stamp {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-8);
}

.mr-brand-name {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.32em;
  color: var(--chapter-accent);
  opacity: 0.9;
}

.mr-brand-sep {
  font-size: 22rpx;
  color: var(--chapter-accent);
  opacity: 0.4;
}

.mr-brand-quiz {
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: var(--chapter-accent);
  opacity: 0.5;
}

/* Group badge */
.mr-group-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  margin-bottom: var(--space-8);
  padding: 6rpx 18rpx;
  border: 1rpx solid var(--chapter-accent);
  border-radius: 100rpx;
  align-self: flex-start;
  width: fit-content;
}

.mr-group-text,
.mr-group-en {
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: var(--chapter-accent);
  opacity: 0.75;
}

.mr-group-sep {
  font-size: 22rpx;
  color: var(--chapter-accent);
  opacity: 0.35;
}

/* Type code + names */
.mr-type-block {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: var(--space-6);
  margin-bottom: var(--space-8);
}

.mr-type-code {
  font-size: 88rpx;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: var(--text);
  line-height: 1;
}

.mr-type-names {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-bottom: 8rpx;
}

.mr-type-zh {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.1em;
  line-height: 1.2;
}

.mr-type-en {
  font-size: 26rpx;
  color: var(--text-muted);
  letter-spacing: 0.14em;
}

/* Subtitle */
.mr-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 0.06em;
  line-height: 1.7;
  margin-bottom: var(--space-4);
}

/* Token */
.mr-token {
  display: block;
  font-size: 24rpx;
  letter-spacing: 0.44em;
  color: var(--chapter-accent);
  opacity: 0.55;
  margin-bottom: var(--space-10);
}

/* ── Dimension bars ───────────────────────────────────── */
.mr-dim-bars {
  margin-top: var(--space-10);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.mr-dim-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mr-dim-poles {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.mr-dim-pole {
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  opacity: 0.45;
}

.mr-dim-pole.active {
  color: var(--chapter-accent);
  opacity: 1;
  font-weight: 600;
}

.mr-dim-track {
  position: relative;
  width: 100%;
  height: 4rpx;
  background: rgba(255,255,255,0.07);
  border-radius: 2rpx;
  overflow: hidden;
}

.mr-dim-fill {
  position: absolute;
  top: 0;
  height: 100%;
  background: var(--chapter-accent);
  opacity: 0.8;
  border-radius: 2rpx;
}

.mr-dim-fill.fill-left  { left: 0; }
.mr-dim-fill.fill-right { right: 0; }

.mr-dim-center-line {
  position: absolute;
  left: 50%;
  top: -3rpx;
  width: 2rpx;
  height: 10rpx;
  background: rgba(255,255,255,0.18);
  transform: translateX(-50%);
}

.mr-dim-pcts {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.mr-dim-pct {
  font-size: 22rpx;
  color: var(--text-muted);
  opacity: 0.4;
  letter-spacing: 0.04em;
}

.mr-dim-pct.active {
  color: var(--chapter-accent);
  opacity: 0.9;
}

/* ── Content ─────────────────────────────────────────── */
.mr-content {
  padding: var(--space-12) var(--space-14) var(--space-20);
}

/* ── Bold quote ──────────────────────────────────────── */
.mr-bold-quote {
  margin-bottom: var(--space-12);
  padding: var(--space-8) var(--space-8);
  border-left: 2rpx solid var(--chapter-accent);
  background: rgba(255,255,255,0.022);
}

.mr-bold-quote-mark {
  display: block;
  font-size: 52rpx;
  line-height: 0.6;
  color: var(--chapter-accent);
  opacity: 0.35;
  font-family: Georgia, serif;
}

.mr-bold-quote-mark.close {
  text-align: right;
  margin-top: var(--space-4);
}

.mr-bold-quote-text {
  display: block;
  font-size: 34rpx;
  line-height: 1.9;
  color: var(--text);
  opacity: 0.88;
  letter-spacing: 0.04em;
  padding: var(--space-4) 0;
}

/* ── Sections ────────────────────────────────────────── */
.mr-section {
  margin-bottom: var(--space-16);
  padding-bottom: var(--space-16);
  border-bottom: 1rpx solid var(--divider);
}

.mr-section:last-of-type { border-bottom: none; }

.mr-section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: var(--space-4);
  margin-bottom: var(--space-8);
}

.mr-section-num {
  font-size: 22rpx;
  letter-spacing: 0.1em;
  color: var(--chapter-accent);
  opacity: 0.45;
  font-weight: 600;
}

.mr-section-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: var(--chapter-accent);
}

/* Paragraphs */
.mr-paras {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}

.mr-para {
  display: block;
  font-size: 34rpx;
  line-height: 2;
  color: var(--text-secondary);
  letter-spacing: 0.05em;
}

/* ── Verse ───────────────────────────────────────────── */
.mr-verse {
  margin-bottom: var(--space-16);
  padding: var(--space-10) 0 var(--space-10);
  border-top: 1rpx solid var(--divider);
  border-bottom: 1rpx solid var(--divider);
}

.mr-verse-rule {
  width: 24rpx;
  height: 1rpx;
  background: var(--chapter-accent);
  opacity: 0.5;
  margin-bottom: var(--space-6);
}

.mr-verse-text {
  display: block;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1.9;
  color: var(--text);
  letter-spacing: 0.1em;
  opacity: 0.88;
  margin-bottom: var(--space-6);
}

.mr-verse-source {
  display: block;
  font-size: 24rpx;
  color: var(--chapter-accent);
  letter-spacing: 0.14em;
  opacity: 0.5;
  text-align: right;
}

/* ── Trait lists ─────────────────────────────────────── */
.mr-trait-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-10);
}

.mr-trait-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-5);
}

.mr-trait-dot {
  flex-shrink: 0;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  margin-top: 16rpx;
}

.mr-trait-dot.pos {
  background: var(--chapter-accent);
  opacity: 0.85;
}

.mr-trait-dot.neg {
  background: var(--text-muted);
  opacity: 0.45;
}

.mr-trait-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.mr-trait-label {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.08em;
  line-height: 1.4;
}

.mr-trait-desc {
  font-size: 32rpx;
  line-height: 1.9;
  color: var(--text-muted);
  letter-spacing: 0.04em;
}

/* ── Actions ─────────────────────────────────────────── */
.mr-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-top: var(--space-8);
}

.mr-share-btn {
  margin: 0;
  border-radius: 0;
  -webkit-appearance: none;
  appearance: none;
  display: block;
  width: 100%;
  padding: var(--space-5) 0;
  font-size: 30rpx;
  letter-spacing: 0.14em;
  text-align: center;
  border: 1rpx solid var(--chapter-accent);
  background: var(--chapter-accent);
  color: #101010;
  font-weight: 600;
  line-height: 1.5;
  box-sizing: border-box;
}

.mr-share-btn::after { display: none; }

.mr-actions-row {
  display: flex;
  gap: var(--space-3);
}

.mr-secondary-btn,
.mr-tertiary-btn {
  flex: 1;
  margin: 0;
  padding: var(--space-5) 0;
  font-size: 28rpx;
  letter-spacing: 0.12em;
  text-align: center;
  border-radius: 0;
  line-height: 1.5;
}

.mr-secondary-btn {
  border: 1rpx solid var(--border);
  color: var(--text-secondary);
  background: transparent;
}

.mr-tertiary-btn {
  border: 1rpx solid var(--border);
  color: var(--text-muted);
  background: transparent;
}

.mr-secondary-btn::after,
.mr-tertiary-btn::after { display: none; }
