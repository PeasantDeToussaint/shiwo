/* ── Scroll container ─────────────────────────────────────── */
.rr-scroll {
  height: 100vh;
  background: var(--bg);
}

.rr-shell {
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── Hero: full-bleed painting ────────────────────────────── */
.rr-hero-wrap {
  position: relative;
  width: 100%;
  height: 72vh;
  overflow: hidden;
  /* Fallback if character painting fails to load */
  background: linear-gradient(160deg, #2a1f14 0%, #0f0a06 100%);
}

.rr-hero-painting {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.rr-hero-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80%;
  background: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0,0,0,0.4) 50%,
    var(--bg) 100%
  );
}

.rr-hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0 var(--space-14) var(--space-10);
  text-align: left;
}

.rr-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.26em;
  color: var(--chapter-accent);
  margin-bottom: var(--space-5);
  font-family: var(--font-family-display);
  opacity: 0.9;
}

.rr-accent-line {
  width: 56rpx;
  height: 1rpx;
  background: var(--chapter-accent);
  margin-bottom: var(--space-8);
  transform-origin: left center;
}

/* Verse: atmospheric poetry, clearly subordinate to the title */
.rr-verse {
  display: block;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 0.16em;
  margin-bottom: var(--space-2);
  font-family: var(--font-family-body);
  font-style: italic;
}

.rr-verse-source {
  display: block;
  font-size: 18rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 0.08em;
  margin-bottom: var(--space-8);
}

.rr-name-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

/* Title: the dominant hero — the answer to the whole quiz */
.rr-title {
  font-size: 60rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.06em;
  line-height: 1.15;
  text-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.6);
}

.rr-subtitle {
  font-size: 24rpx;
  color: var(--chapter-accent);
  letter-spacing: 0.26em;
  opacity: 0.9;
}

/* ── Content sections area ────────────────────────────────── */
.rr-content {
  padding: var(--space-12) var(--space-14) var(--space-20);
  box-sizing: border-box;
}

/* ── Quick takeaway — cinematic reveal, not a UI chip ─────── */
.rr-takeaway {
  margin-bottom: var(--space-12);
  padding: var(--space-6) 0 var(--space-8);
  border-bottom: 1rpx solid var(--divider);
}

.rr-takeaway-label {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.28em;
  color: var(--chapter-accent);
  margin-bottom: var(--space-5);
  opacity: 0.65;
}

.rr-takeaway-text {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.55;
  color: var(--text);
  letter-spacing: 0.06em;
}

.rr-trait-row {
  margin-top: var(--space-6);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.rr-trait-chip {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 8rpx 20rpx;
}

.rr-trait-chip-text {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 0.14em;
}

/* ── Sections ─────────────────────────────────────────────── */
.rr-section {
  margin-bottom: var(--space-16);
  text-align: left;
}

/* 画像 opener — the most important section, reads first */
.rr-section-opener {
  margin-bottom: var(--space-18);
  padding-bottom: var(--space-14);
  border-bottom: 1rpx solid var(--divider);
}

.rr-section-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.24em;
  color: var(--chapter-accent);
  margin-bottom: var(--space-6);
  border-left: 2rpx solid var(--chapter-accent);
  padding-left: var(--space-4);
}

.rr-section-body {
  display: block;
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--text-secondary);
  letter-spacing: 0.05em;
}

/* Opener body — slightly larger, higher contrast */
.rr-section-body-opener {
  font-size: 34rpx;
  color: var(--text);
  line-height: 1.9;
  letter-spacing: 0.06em;
}

/* ── Attribute cluster (novel echo / temperament / situation) ─ */
.rr-attr-block {
  margin-bottom: var(--space-18);
  border: 1rpx solid var(--border);
  background: rgba(255, 255, 255, 0.018);
}

.rr-attr-item {
  padding: var(--space-8) var(--space-8);
  border-bottom: 1rpx solid var(--divider);
}

.rr-attr-item-last {
  border-bottom: none;
}

/* ── Mid-section break ────────────────────────────────────── */
.rr-mid-break {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  margin: var(--space-4) 0 var(--space-16);
}

.rr-mid-break-line {
  flex: 1;
  height: 1rpx;
  background: var(--divider);
}

.rr-mid-break-label {
  font-size: 18rpx;
  letter-spacing: 0.24em;
  color: var(--chapter-accent);
  opacity: 0.5;
  white-space: nowrap;
}

/* ── Destiny — epilogue, distinct closing statement ────────── */
.rr-destiny-wrap {
  margin-top: var(--space-16);
  margin-bottom: var(--space-14);
  padding-top: var(--space-10);
  border-top: 1rpx solid var(--divider);
}

.rr-destiny-text {
  display: block;
  font-size: 34rpx;
  font-style: italic;
  line-height: 1.9;
  color: var(--text-secondary);
  letter-spacing: 0.07em;
  opacity: 0.88;
}

/* ── Classic Scenes ───────────────────────────────────────── */
.rr-scenes {
  margin-bottom: var(--space-14);
  text-align: left;
}

.rr-scene-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.rr-scene-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-5);
}

.rr-scene-bullet {
  flex-shrink: 0;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--chapter-accent);
  margin-top: 22rpx;
  opacity: 0.7;
}

.rr-scene-text {
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  flex: 1;
}

/* ── Classic Quote ────────────────────────────────────────── */
.rr-quote-wrap {
  margin-bottom: var(--space-16);
  border-left: 2rpx solid var(--chapter-accent);
  padding-left: var(--space-8);
  padding-top: var(--space-2);
  padding-bottom: var(--space-2);
}

.rr-quote {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text);
  letter-spacing: 0.08em;
  font-style: italic;
}

/* ── Sub-type Block ───────────────────────────────────────── */
.rr-subtype-wrap {
  margin-bottom: var(--space-12);
  padding: var(--space-8) var(--space-7);
  border: 1rpx solid var(--border);
  background: rgba(255, 255, 255, 0.02);
}

.rr-subtype-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
}

.rr-subtype-accent-line {
  width: 24rpx;
  height: 1rpx;
  background: var(--chapter-accent);
  opacity: 0.6;
}

.rr-subtype-label {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--chapter-accent);
  opacity: 0.7;
}

.rr-subtype-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.08em;
  margin-bottom: var(--space-5);
}

.rr-subtype-body {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--text-secondary);
  letter-spacing: 0.04em;
  margin-bottom: var(--space-6);
}

/* ── Tension ──────────────────────────────────────────────── */
.rr-tension-wrap {
  border-top: 1rpx solid var(--divider);
  padding-top: var(--space-6);
}

.rr-tension-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--text-muted);
  margin-bottom: var(--space-4);
}

.rr-tension-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.85;
  color: var(--text-muted);
  letter-spacing: 0.04em;
}

/* ── Actions ──────────────────────────────────────────────── */
.rr-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-top: var(--space-4);
}

/* Primary CTA — full width, filled accent */
.rr-card-btn {
  border: 1rpx solid var(--chapter-accent);
  background: var(--chapter-accent);
  color: #101010;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  padding: var(--space-6) 0;
  text-align: center;
}

/* Share button — full width, outlined */
.rr-share-btn {
  padding: var(--space-5) 0;
  font-size: 26rpx;
  letter-spacing: 0.14em;
  text-align: center;
  border: 1rpx solid var(--border);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* Secondary row — two quiet buttons side by side */
.rr-actions-row {
  display: flex;
  gap: var(--space-3);
}

.rr-secondary-btn,
.rr-tertiary-btn {
  flex: 1;
  margin: 0;
  padding: var(--space-5) 0;
  font-size: 24rpx;
  letter-spacing: 0.12em;
  text-align: center;
  border-radius: 0;
  line-height: 1.5;
}

.rr-secondary-btn {
  border: 1rpx solid var(--chapter-accent);
  color: var(--chapter-accent);
  background: transparent;
}

.rr-tertiary-btn {
  border: 1rpx solid var(--border);
  color: var(--text-muted);
  background: transparent;
}

/* ── Card Overlay ─────────────────────────────────────────── */
.rr-card-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  animation: overlay-in 0.22s ease both;
}

@keyframes overlay-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.rr-card-preview-wrap {
  width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-6);
  animation: card-reveal 0.32s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
}

@keyframes card-reveal {
  from { opacity: 0; transform: scale(0.92) translateY(16rpx); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* ── Identity Card ────────────────────────────────────────── */
.rr-identity-card {
  width: 600rpx;
}

.rr-ic-bg {
  position: relative;
  width: 600rpx;
  height: 800rpx;
  overflow: hidden;
  background: var(--bg);
  padding: 60rpx 48rpx 52rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
}

/* Painting texture — visible enough to feel alive */
.rr-ic-painting {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.28;
}

/* Tint: painting breathes in the upper half, darkens toward footer */
.rr-ic-tint {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.18) 0%,
    rgba(0, 0, 0, 0.52) 55%,
    rgba(0, 0, 0, 0.82) 100%
  );
}

.rr-ic-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 48rpx;
}

/* Brand row — slightly more confident, not apologetic */
.rr-ic-brand {
  font-size: 22rpx;
  letter-spacing: 0.28em;
  color: rgba(255, 255, 255, 0.55);
  font-family: var(--font-family-display);
}

.rr-ic-chapter {
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: rgba(255, 255, 255, 0.3);
}

.rr-ic-accent-line {
  position: relative;
  width: 48rpx;
  height: 1rpx;
  background: var(--chapter-accent);
  margin-bottom: 36rpx;
}

/* Verse — the poster focal point, the line people will remember */
.rr-ic-verse {
  position: relative;
  display: block;
  font-size: 54rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.16em;
  line-height: 1.3;
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.5);
}

.rr-ic-title {
  position: relative;
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--chapter-accent);
  letter-spacing: 0.2em;
  margin-bottom: 6rpx;
}

.rr-ic-subtitle {
  position: relative;
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0.14em;
  margin-bottom: 40rpx;
}

.rr-ic-portrait {
  position: relative;
  display: block;
  font-size: 22rpx;
  line-height: 1.85;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 0.04em;
  margin-bottom: 0;
  flex: 1;
}

/* Footer pinned to bottom via flex layout */
.rr-ic-footer {
  position: relative;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-top: 24rpx;
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.rr-ic-tagline {
  font-size: 17rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 0.1em;
}

.rr-ic-copy {
  font-size: 15rpx;
  letter-spacing: 0.22em;
  color: rgba(255, 255, 255, 0.25);
}

/* ── Card action row ──────────────────────────────────────── */
.rr-card-save-row {
  display: flex;
  gap: var(--space-4);
  width: 100%;
}

.rr-card-save-btn {
  flex: 1;
  border: 1rpx solid var(--chapter-accent);
  color: var(--chapter-accent);
  font-size: 26rpx;
  letter-spacing: 0.12em;
  padding: var(--space-5) 0;
  text-align: center;
}

.rr-card-save-btn-loading { opacity: 0.5; }

.rr-card-close-btn {
  flex: 1;
  border: 1rpx solid var(--border);
  color: var(--text-muted);
  font-size: 26rpx;
  letter-spacing: 0.12em;
  padding: var(--space-5) 0;
  text-align: center;
}
